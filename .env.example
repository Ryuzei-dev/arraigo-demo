# ============================================================
# Arraigo · Variables de entorno
# Copia este archivo como .env.local y llena los valores.
# Sin estas llaves, el formulario funciona en MODO DEMO
# (registra el lead en el log del servidor y responde éxito).
# ============================================================

# --- Correo de notificación de leads (Resend) ---
# Crea tu API key gratis en https://resend.com/api-keys
RESEND_API_KEY=
# Correo donde quieres recibir los leads (ej. ventas@arraigo.example)
LEAD_NOTIFY_EMAIL=
# Remitente verificado en Resend. Para probar puedes usar el de sandbox:
LEAD_FROM_EMAIL=Arraigo <onboarding@resend.dev>

# --- CRM (HubSpot) ---
# Private App token: HubSpot > Settings > Integrations > Private Apps
# Scope necesario: crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=

# Google Analytics 4 (opcional). Ejemplo: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Search Console: código de la etiqueta meta de verificación (opcional)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Sanity (CMS de propiedades) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Token con permiso de escritura (solo scripts de carga de datos, nunca en el navegador ni en Vercel)
SANITY_WRITE_TOKEN=
# Secreto compartido con el webhook de Sanity (app/api/revalidate). Genera uno largo y aleatorio.
SANITY_REVALIDATE_SECRET=
